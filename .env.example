# App
NEXT_PUBLIC_SITE_URL=https://portfolio.aswin-ambalathara.space
NODE_ENV=production
APP_PORT=3000

# Payload / DB
PAYLOAD_SECRET=change-me-long-random
# Production (Docker network). For local development use mongodb://localhost:27018/portfolio
DATABASE_URI=mongodb://mongo:27017/portfolio
ADMIN_EMAIL={{EMAIL}}
ADMIN_PASSWORD=change-me

# Contact email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL={{EMAIL}}

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI chatbot
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
CHAT_PRIMARY_MODEL=
CHAT_FALLBACK_MODEL=

# GitHub stats
GITHUB_TOKEN=
GITHUB_USERNAME={{GITHUB_USERNAME}}

# Analytics (optional)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Deploy
IMAGE_TAG=latest
