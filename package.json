{
    "name":  "portfolio",
    "version":  "1.0.0",
    "description":  "Developer portfolio built with Next.js and Payload CMS",
    "license":  "UNLICENSED",
    "type":  "module",
    "scripts":  {
                    "build":  "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
                    "dev":  "cross-env NODE_OPTIONS=--no-deprecation next dev",
                    "devsafe":  "rm -rf .next \u0026\u0026 cross-env NODE_OPTIONS=--no-deprecation next dev",
                    "generate:importmap":  "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
                    "generate:types":  "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
                    "lint":  "cross-env NODE_OPTIONS=--no-deprecation eslint .",
                    "payload":  "cross-env NODE_OPTIONS=--no-deprecation payload",
                    "start":  "cross-env NODE_OPTIONS=--no-deprecation next start",
                    "typecheck":  "next typegen \u0026\u0026 tsc --noEmit"
                },
    "dependencies":  {
                         "@payloadcms/db-mongodb":  "3.92.1",
                         "@payloadcms/next":  "3.92.1",
                         "@payloadcms/richtext-lexical":  "3.92.1",
                         "@payloadcms/ui":  "3.92.1",
                         "class-variance-authority":  "^0.7.1",
                         "cn":  "^0.5.2",
                         "cross-env":  "^7.0.3",
                         "dotenv":  "16.4.7",
                         "graphql":  "^16.8.1",
                         "lucide-react":  "^1.66.0",
                         "next":  "16.3.3",
                         "next-themes":  "^0.4.6",
                         "payload":  "3.92.1",
                         "radix-ui":  "^1.8.1",
                         "react":  "19.2.6",
                         "react-dom":  "19.2.6",
                         "shadcn":  "^4.23.0",
                         "sharp":  "0.35.4",
                         "tw-animate-css":  "^1.4.0",
                         "zod":  "^4.6.7"
                     },
    "devDependencies":  {
                            "@tailwindcss/postcss":  "^4.3.3",
                            "@types/node":  "22.19.9",
                            "@types/react":  "19.2.14",
                            "@types/react-dom":  "19.2.3",
                            "eslint":  "^9.16.0",
                            "eslint-config-next":  "16.3.3",
                            "postcss":  "^8.5.32",
                            "prettier":  "^3.4.2",
                            "tailwindcss":  "^4.3.3",
                            "typescript":  "5.7.3"
                        },
    "engines":  {
                    "node":  "^22.23.4 || \u003e=24.22.1",
                    "pnpm":  "^9 || ^10 || ^11"
                },
    "pnpm":  {
                 "onlyBuiltDependencies":  [
                                               "sharp",
                                               "esbuild",
                                               "unrs-resolver"
                                           ]
             },
    "packageManager":  "pnpm@10.7.0"
}
